{
  "name": "helm",
  "version": "0.1.0",
  "private": true,
  "description": "HELM — governed, multiplayer AI workspace",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "db:migrate": "bun --cwd backend run db:migrate",
    "db:reset": "bun --cwd backend run db:reset",
    "typecheck": "bun --cwd backend run typecheck && bun --cwd frontend run typecheck",
    "build": "bun --cwd backend run build && bun --cwd frontend run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
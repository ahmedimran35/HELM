# Bootstrap admin (used only on first boot, when users table is empty)
ADMIN_USERNAME=admin@helm.local
# REQUIRED — no default is shipped (a known-password admin account is a
# critical hole). Generate one before first boot:
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Database
DATABASE_URL=postgres://helm:helm_dev@localhost:5432/helm

# Redis (used by later phases for quotas, WS pub/sub)
REDIS_URL=redis://localhost:6379

# Legacy key-material salt for provider ciphertexts (v1) and the
# session layer. NOTE: it does NOT sign cookies — sessions are opaque
# server-side IDs in the `sessions` table. Changing it does not by
# itself log anyone out, but it does break `v1:` provider-key blobs.
# Generate a real one for production; leave empty to let the backend
# create an ephemeral dev secret (logged as a warning).
#   SESSION_SECRET=$(openssl rand -hex 32)
SESSION_SECRET=

# Dedicated salt for current (v2) provider ciphertexts. Falls back to
# SESSION_SECRET when unset. See SECRETS-ROTATION.md §2 — there is no
# zero-downtime rotation for this value.
# PROVIDER_KEY_SECRET=

# API port
API_PORT=3000

# Frontend dev server
WEB_PORT=5173

# CORS origin (frontend dev)
WEB_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────
# OAuth (P5) — identity linking for Google / GitHub / Microsoft.
# Leave any provider's pair empty to disable that provider; the
# /api/oauth/:provider/start endpoint will return 503 with a clear
# "provider_not_configured" message.
# ─────────────────────────────────────────────────────────────────────

# Google — create an OAuth client at https://console.cloud.google.com/apis/credentials
# Redirect URI: ${OAUTH_REDIRECT_BASE:-http://localhost:3000}/api/oauth/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub — create an OAuth app at https://github.com/settings/developers
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Microsoft — register an app at https://entra.microsoft.com (Applications → App registrations)
# Optional: pin the tenant (defaults to "common" which allows any MSA / org account).
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common

# Optional override for the OAuth callback base. If unset, the backend
# derives it from the request URL. Set this in production so the redirect
# URI exactly matches what's registered with each provider.
# OAUTH_REDIRECT_BASE=https://api.example.com

# First-time OAuth signup. HELM has no public sign-up (accounts are seeded
# at deploy time or created by an admin), so an OAuth callback will only
# sign in / link an EXISTING account. Set this to 1 to also let an unknown
# external identity create a fresh local account (self-service signup).
# OAUTH_ALLOW_SIGNUP=0

# ─────────────────────────────────────────────────────────────────────
# Slack-native inbound (P5)
# ─────────────────────────────────────────────────────────────────────

# Signing secret — used by Slack to HMAC every inbound event. Found at
# https://api.slack.com/apps → your app → "Basic Information" → "Signing Secret".
SLACK_SIGNING_SECRET=

# OAuth app credentials for "Add to Slack" → bot install flow.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional: scopes requested during the install flow (comma-separated).
SLACK_SCOPES=app_mentions:read,chat:write,im:history,channels:history,groups:history,commands

# Optional override for the Slack install callback base. If unset, the
# backend derives it from the request URL.
# SLACK_REDIRECT_BASE=https://api.example.com

# ─────────────────────────────────────────────────────────────────────
# Operational / hardening knobs (all optional, defaults shown)
# ─────────────────────────────────────────────────────────────────────

# Trust the left-most x-forwarded-for hop for client-IP bucketing
# (rate limits, session IP-bind). Only set this behind a proxy that
# overwrites the header — otherwise a client can spoof its IP.
# HELM_TRUSTED_PROXY=0

# Revoke a session when a request arrives from a different IP. Off by
# default (mobile/NAT users would be logged out constantly).
# HELM_SESSION_IP_BIND=0

# Failed-login lockout (see docs/runbooks/incident-triage.md §3).
# HELM_LOGIN_LOCKOUT_THRESHOLD=5
# HELM_LOGIN_LOCKOUT_MINUTES=15

# Idle session expiry, seconds (sliding window on last activity).
# Default 86400 (24h). The absolute session lifetime is 7 days
# regardless of activity.
# HELM_IDLE_TTL_SECONDS=86400

# bcrypt cost for password hashing (clamped 4–15).
# BCRYPT_COST=10

# Log level: off | error | warn | info (default info; use off in prod).
# HELM_LOG_LEVEL=info

# Emit a warning for any query slower than this many ms.
# HELM_LOG_SLOW_QUERY_MS=200

# Audit-log retention in days (daily pruning job).
# HELM_AUDIT_RETENTION_DAYS=90

# Response-cache TTL in seconds. 0 disables the cache.
# HELM_RESPONSE_CACHE_TTL_SECONDS=3600

# Allow providers pointed at localhost/private IPs (SSRF guard bypass —
# dev only).
# HELM_ALLOW_LOCAL_PROVIDERS=0

# Alerting webhook + minimum severity to forward (info|warn|error).
# HELM_ALERT_WEBHOOK_URL=
# HELM_ALERT_MIN_SEVERITY=warn

# ─────────────────────────────────────────────────────────────────────
# Sandbox (shell exec is DISABLED by default — see SANDBOX-ISOLATION.md)
# ─────────────────────────────────────────────────────────────────────

# Linux only: wrap exec in `unshare` user/net/pid namespaces. The
# server probes for the `unshare` binary at boot and stays disabled if
# it is missing.
# SANDBOX_USE_UNSHARE=0

# Single-user dev hosts only. Re-enables the plain `bash -c` path with
# NO isolation. NEVER set this on a shared or production deployment.
# SANDBOX_ALLOW_UNSAFE_EXEC=0
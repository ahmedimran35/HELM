    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "7.31.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "postcss": "^8.4.49",

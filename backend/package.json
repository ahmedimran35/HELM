{
  "name": "@helm/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:migrate": "bun src/db/migrate.ts",
    "db:reset": "bun src/db/reset.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:bcrypt": "bun scripts/bcrypt-compat-test.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "build": "bun build src/index.ts --outdir=dist --target=bun --external @helm/shared"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.0",
    "bcryptjs": "^3.0.0",
    "cron-parser": "^4.9.0",
    "hono": "^4.6.0",
    "postgres": "^3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0"
  }
}
